# CampusFix Environment Configuration Example
# When connecting to Google Cloud Firebase production:
VITE_FIREBASE_API_KEY=AIzaSyExampleKey12345
VITE_FIREBASE_AUTH_DOMAIN=campusfix-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=campusfix-prod
VITE_FIREBASE_STORAGE_BUCKET=campusfix-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_DATABASE_ID=(default)

# Note: In development and evaluation mode without Firebase credentials,
# CampusFix automatically boots its real-time reactive sync engine with full cross-tab
# BroadcastChannel support, pre-seeded with 5 students, 4 technicians, 1 admin, and 10 complaints.
